# Copy this file's variable names into Vercel's Project Settings -> Environment
# Variables. Never commit real values -- this file is just documentation of
# what's required.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing -- required for the Upgrade to Premium flow to work.
# Leave blank until you've created a Stripe account; the app degrades
# gracefully (shows "Billing isn't set up yet") when these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
